# TMS API - Environment Configuration
# Copy this file to .env and update values as needed

# ============ CYODA CONFIGURATION ============
# Real Cyoda instance (EU)
CYODA_HOST=client-a680fca7878e4c73854cfce50b42a108-dev.eu.cyoda.net
CYODA_CLIENT_ID=kLXY45
CYODA_CLIENT_SECRET=OAIsUzQMP4LoW19JTwoi

# ============ APPLICATION CONFIGURATION ============
# Server port
SERVER_PORT=8080

# Spring profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=default

# ============ CORS CONFIGURATION ============
# Allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ LOGGING ============
# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ============ GRPC CONFIGURATION ============
# gRPC settings (usually auto-configured from CYODA_HOST)
GRPC_ADDRESS=grpc-client-a680fca7878e4c73854cfce50b42a108-dev.eu.cyoda.net
GRPC_PORT=443

# ============ THREAD POOLS ============
PROCESSOR_THREAD_POOL=20
CRITERIA_THREAD_POOL=20
CONTROL_THREAD_POOL=3

# ============ SSL CONFIGURATION ============
# For production, set to false
SSL_TRUST_ALL=false

# ============ FEATURE FLAGS ============
# Include default operations for testing
INCLUDE_DEFAULT_OPERATIONS=false

