# Cyoda Platform Configuration
APP_CONFIG_CYODA_HOST=localhost:8443
APP_CONFIG_CYODA_CLIENT_ID=your-client-id
APP_CONFIG_CYODA_CLIENT_SECRET=your-client-secret

# Entity Search API Configuration
# API token for authenticating requests to the Cyoda entity search endpoint
# Required for /items/search endpoint to forward authorization to Cyoda
CYODA_API_TOKEN=your-api-token-here

# gRPC Configuration
APP_CONFIG_GRPC_ADDRESS=grpc-localhost:8443
APP_CONFIG_GRPC_SERVER_PORT=443

# SSL Configuration (for development only)
CONNECTION_GRPC_SKIP_SSL=false

