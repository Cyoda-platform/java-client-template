{
  "version": "1.0",
  "name": "Order",
  "description": "Order processing workflow: Created -> Validated -> Charged -> Completed -> Failed",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "charged": {
      "transitions": [
        {
          "description": "Complete order and update inventory",
          "manual": true,
          "name": "complete_order",
          "next": "completed",
          "processors": [
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              },
              "executionMode": "ASYNC_NEW_TX",
              "name": "PersistOrder"
            },
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              },
              "executionMode": "ASYNC_NEW_TX",
              "name": "UpdateInventory"
            }
          ]
        },
        {
          "description": "Mark order as failed",
          "manual": true,
          "name": "fail_order",
          "next": "failed"
        }
      ]
    },
    "completed": {
      "transitions": []
    },
    "failed": {
      "transitions": []
    },
    "initial_state": {
      "transitions": [
        {
          "description": "Validate order inventory and total",
          "manual": true,
          "name": "validate_order",
          "next": "validated",
          "processors": [
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              },
              "executionMode": "ASYNC_NEW_TX",
              "name": "ValidateOrder"
            }
          ]
        },
        {
          "description": "Mark order as failed",
          "manual": true,
          "name": "fail_order",
          "next": "failed"
        }
      ]
    },
    "validated": {
      "transitions": [
        {
          "description": "Charge payment for order",
          "manual": true,
          "name": "charge_payment",
          "next": "charged",
          "processors": [
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              },
              "executionMode": "ASYNC_NEW_TX",
              "name": "ChargePayment"
            }
          ]
        },
        {
          "description": "Mark order as failed",
          "manual": true,
          "name": "fail_order",
          "next": "failed"
        }
      ]
    }
  }
}