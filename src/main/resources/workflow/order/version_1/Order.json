{
  "version": "1.0",
  "name": "Order",
  "desc": "Order processing workflow: Created -> Validated -> Charged -> Completed -> Failed",
  "initialState": "initial",
  "active": true,
  "states": {
    "initial": {
      "transitions": [
        {
          "name": "validate_order",
          "next": "validated",
          "manual": true,
          "description": "Validate order inventory and total",
          "processors": [
            {
              "name": "ValidateOrder",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        },
        {
          "name": "fail_order",
          "next": "failed",
          "manual": true,
          "description": "Mark order as failed"
        }
      ]
    },
    "validated": {
      "transitions": [
        {
          "name": "charge_payment",
          "next": "charged",
          "manual": true,
          "description": "Charge payment for order",
          "processors": [
            {
              "name": "ChargePayment",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        },
        {
          "name": "fail_order",
          "next": "failed",
          "manual": true,
          "description": "Mark order as failed"
        }
      ]
    },
    "charged": {
      "transitions": [
        {
          "name": "complete_order",
          "next": "completed",
          "manual": true,
          "description": "Complete order and update inventory",
          "processors": [
            {
              "name": "PersistOrder",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              }
            },
            {
              "name": "UpdateInventory",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 5000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        },
        {
          "name": "fail_order",
          "next": "failed",
          "manual": true,
          "description": "Mark order as failed"
        }
      ]
    },
    "completed": {
      "transitions": []
    },
    "failed": {
      "transitions": []
    }
  }
}

