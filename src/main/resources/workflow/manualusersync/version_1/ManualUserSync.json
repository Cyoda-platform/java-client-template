{
  "version": "1",
  "name": "ManualUserSync",
  "description": "Manual workflow to synchronize users from Auth0 and merge into the local store (Auth0 authoritative)",
  "initialState": "idle",
  "active": true,
  "states": {
    "completed": {
      "transitions": []
    },
    "failed": {
      "transitions": [
        {
          "manual": true,
          "name": "retry",
          "next": "syncing"
        }
      ]
    },
    "idle": {
      "transitions": [
        {
          "manual": true,
          "name": "start_sync",
          "next": "syncing"
        }
      ]
    },
    "syncing": {
      "transitions": [
        {
          "manual": false,
          "name": "complete",
          "next": "completed",
          "processors": [
            {
              "config": {
                "attachEntity": false,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 60000,
                "retryPolicy": "FIXED"
              },
              "executionMode": "SYNC",
              "name": "Auth0Fetch"
            },
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 120000,
                "retryPolicy": "EXPONENTIAL"
              },
              "executionMode": "SYNC",
              "name": "MergeUsers"
            }
          ]
        },
        {
          "manual": false,
          "name": "fail",
          "next": "failed"
        }
      ]
    }
  }
}