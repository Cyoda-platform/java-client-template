{
  "version": "1.0",
  "name": "Loan",
  "desc": "Corporate loan lifecycle workflow with application, approval, and disbursement states",
  "initialState": "initial",
  "active": true,
  "states": {
    "initial": {
      "transitions": [
        {
          "name": "submit_application",
          "next": "submitted",
          "manual": false
        }
      ]
    },
    "submitted": {
      "transitions": [
        {
          "name": "approve_loan",
          "next": "approved",
          "manual": true,
          "processors": [
            {
              "name": "LoanApprovalProcessor",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 3000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        },
        {
          "name": "reject_loan",
          "next": "rejected",
          "manual": true,
          "processors": [
            {
              "name": "LoanRejectionProcessor",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 3000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "approved": {
      "transitions": [
        {
          "name": "disburse_loan",
          "next": "active",
          "manual": true,
          "processors": [
            {
              "name": "LoanDisbursementProcessor",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 3000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "close_loan",
          "next": "closed",
          "manual": true,
          "processors": [
            {
              "name": "LoanClosureProcessor",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 3000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "rejected": {
      "transitions": []
    },
    "closed": {
      "transitions": []
    }
  }
}

