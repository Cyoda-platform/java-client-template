{
  "version": "1.0",
  "name": "RegulatoryReporting",
  "desc": "Regulatory reporting workflow for SAR/STR generation, approval, and submission with integrity verification",
  "initialState": "draft",
  "active": true,
  "metadata": {
    "retentionDays": 2555,
    "supportedJurisdictions": ["US", "EU"],
    "reportVersioning": true,
    "integrityHashAlgorithm": "SHA256",
    "audit": {
      "enabled": true,
      "fields": ["actor", "timestamp", "from", "to", "reason"]
    }
  },
  "states": {
    "draft": {
      "transitions": [
        {
          "name": "submitForReview",
          "next": "review",
          "manual": true,
          "processors": [
            {"name": "CollectReportData"}
          ]
        }
      ]
    },
    "review": {
      "transitions": [
        {
          "name": "approveReport",
          "next": "approved",
          "manual": true,
          "processors": [
            {"name": "RenderTemplate"}
          ]
        },
        {
          "name": "rejectReport",
          "next": "draft",
          "manual": true,
          "processors": []
        }
      ]
    },
    "approved": {
      "transitions": [
        {
          "name": "SubmitToRegulator",
          "next": "submitted",
          "manual": true,
          "processors": [
            {"name": "SignAndHashExport"},
            {"name": "SubmitToRegulator"}
          ]
        }
      ]
    },
    "submitted": {
      "transitions": [
        {
          "name": "archiveReport",
          "next": "archived",
          "manual": false,
          "processors": []
        }
      ]
    },
    "archived": {
      "transitions": []
    }
  }
}

